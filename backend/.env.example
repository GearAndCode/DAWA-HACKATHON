# DAWA Healthcare API - Configuration
# Copy this file to .env and configure your vision AI or OCR credentials

# 1. Vision AI Configuration (Recommended: Google Gemini Vision)
# Get a key from https://aistudio.google.com/
VISION_API_KEY=
VISION_MODEL=gemini-2.5-flash

# 2. Alternative Document OCR API (OCR.space)
# Get a free API key at https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=

# 3. Security & Demo Keys
DEMO_ADMIN_KEY=dawa-pharmacist-demo-2026
DEFAULT_DELIVERY_FEE=150.0
